# Canonical public URL, without trailing slash
NEXT_PUBLIC_SITE_URL=https://www.example.de

# --- Contact form (app/kontakt) ---------------------------------------------
# SMTP credentials used to send transactional email for the contact form.
# Any standard SMTP provider works (e.g. a transactional-email service, or a
# mailbox provider that allows SMTP app passwords). Never commit real values —
# copy this file to .env.local and fill it in there.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" only for port 465 (implicit TLS). Leave "false" for 587/25 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=postmaster@example.com
SMTP_PASS=change-me
# Sender identity used in the "From" header of both emails.
SMTP_FROM="Prom4Fans <no-reply@prom4fans.de>"

# Inbox that receives new contact-form inquiries (the confirmation email to
# the visitor sets this as its Reply-To).
CONTACT_RECEIVER_EMAIL=julius.blumberg@icloud.com

# Long random string used to sign the contact form's anti-spam timing token
# (see lib/contact-token.ts). Generate one with: openssl rand -hex 32
FORM_SECRET=change-me-to-a-long-random-string
