# This file belongs beside the exported contents of /out on an Apache host.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Root export.
  RewriteRule ^$ index.html [END]

  # Top-level Next static routes. These explicit rewrites intentionally run
  # even when same-named directories exist for nested pages.
  RewriteRule ^(de|en|kontakt|impressum|datenschutz|nutzungsbedingungen|ratgeber)/?$ $1.html [END]

  # SEO service landing pages.
  RewriteRule ^(de|en)/(creator-management|onlyfans-management)/?$ $1/$2.html [END]

  # Editorial guide articles. Slugs are generated statically by Next.js;
  # this rewrite only resolves the clean public URL to the exported HTML.
  RewriteRule ^ratgeber/([a-z0-9-]+)/?$ ratgeber/$1.html [END]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  <FilesMatch "\.(?:css|js|mjs|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, max-age=0"
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
