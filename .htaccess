# Static Next.js export on Apache / IONOS.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical origin, in a single redirect hop.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.prom4fans\.com$ [NC]
  RewriteRule ^ https://www.prom4fans.com%{REQUEST_URI} [L,R=301]

  # The German homepage is the canonical default language entry point.
  RewriteRule ^$ /de [L,R=301]

  # Top-level static routes. Explicit rewrites intentionally run even when
  # same-named directories exist for nested pages.
  RewriteRule ^(de|en|kontakt|impressum|datenschutz|nutzungsbedingungen|ratgeber)/?$ $1.html [END]

  # Service landing pages.
  RewriteRule ^(de|en)/(creator-management|onlyfans-management)/?$ $1/$2.html [END]

  # Editorial guide articles. Slugs are generated statically by Next.js.
  RewriteRule ^ratgeber/([a-z0-9-]+)/?$ ratgeber/$1.html [END]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  <FilesMatch "\.(?:css|js|mjs|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, max-age=0"
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
