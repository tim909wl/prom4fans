# This file belongs beside the exported contents of /out on an Apache host.
# If it is not enabled by your host, ask for AllowOverride FileInfo (or All).
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Some shared-hosting vhosts do not apply DirectoryIndex consistently.
  RewriteRule ^$ index.html [END]
  # Next static export writes route files as /route.html. Prevent Apache's
  # directory slash redirect from turning /de into a forbidden directory.
  RewriteRule ^((?:de|en|kontakt|impressum|datenschutz|nutzungsbedingungen))/?$ $1.html [END]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  <FilesMatch "\.(?:css|js|mjs|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
